{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/frontend",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "apps/backend/src/server.ts"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "-w",
        "apps/frontend",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "apps/backend/src/server.ts"
      ],
      "env": {
        "PORT": "3011"
      },
      "port": 3011
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "apps/frontend",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "env": {
        "VITE_API_URL": "http://localhost:3011",
        "VITE_WS_URL": "ws://localhost:3011"
      },
      "port": 5174
    }
  ]
}
